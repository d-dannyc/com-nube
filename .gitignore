.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt

# 4. Bases de datos locales de auditoria y logs en tiempo real
*.db
*.sqlite
*.sqlite3
cbas_audit.db
cbas_auditoria.db
*.log
*.pid

# 5. Archivos temporales y de bloqueo ofimaticos (Word, LibreOffice, Excel)
