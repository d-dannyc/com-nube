.env
.env.*
!.env.example
*.pem
*.key
*.token
*.secret

# 2. Herramientas de Inteligencia Artificial y Agentes
.agents/
skills-lock.json
.gemini/
.claude/
.cursor/
.windsurf/

# 3. Entornos virtuales y paquetes de Python
venv/
env/
ENV/
.venv/
