# Configuracion OAuth 2.0 de Dropbox Cloud API v2 para CBAS
DROPBOX_APP_KEY=tu_app_key_aqui
DROPBOX_APP_SECRET=tu_app_secret_aqui
DROPBOX_REFRESH_TOKEN=tu_refresh_token_oauth2_aqui

# Configuracion opcional del servidor y agente local
CBAS_BACKEND_HOST=127.0.0.1
CBAS_BACKEND_PORT=5050
CBAS_DROPBOX_FOLDER=/CBAS_Pyme_Vault
